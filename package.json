{
  "name": "everwar-tcg-card-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local browser app that loads the EverWar Card_1.psd, edits its text fields, live-previews on canvas, and exports a PNG.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "batch": "vite-node src/batch/cli.ts --"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.7",
    "ag-psd": "^31.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
